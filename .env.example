## Example environment variables for mazen-poll
# Copy this file to `.env` and fill the values before deploying or running locally.

# DynamoDB table name (matches serverless.yml by default)
POLLS_TABLE=polls-table-dev

# Frontend URL used to generate poll links / QR codes
FRONTEND_URL=http://localhost:5173

# ClickUp integration (optional - only needed for /poll/{id}/send)
CLICKUP_TOKEN=
CLICKUP_WORKSPACE_ID=
CLICKUP_CHANNEL_ID=

# Optional: AWS credentials (if not using a configured AWS profile)
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=us-east-1
